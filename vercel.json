{
  "version": 2,
  "builds": [{
    "src": "package.json",
    "use": "@vercel/static-build",
    "config": {
      "distDir": "dist"
    }
  }],
  "routes": [{
      "src": "/assets/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/datasets/([^/]+)/?",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|Discordbot|WhatsApp|TelegramBot|SkypeUriPreview|MicrosoftPreview|Pinterest|redditbot|Embedly|vkShare|Mastodon|Bluesky|Iframely|Snapchat|Viber).*" }],
      "dest": "https://api.data-dz.com/v1/datasets/$1/share"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
